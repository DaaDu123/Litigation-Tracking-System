# Public browser origin of the deployed frontend.
# Example: http://YOUR_EC2_PUBLIC_IP or https://your-domain.example
FRONTEND_ORIGIN=http://localhost

# Production SQL Server password. Use a strong password.
MSSQL_SA_PASSWORD=CHANGE_ME_StrongSqlPassword123!

# Long random JWT signing secret (at least 32 characters; longer is better).
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Gmail/SMTP credentials used by notification and authentication emails.
SMTP_SENDER_EMAIL=your-sender@example.com
SMTP_APP_PASSWORD=CHANGE_ME_WITH_YOUR_NEW_APP_PASSWORD
