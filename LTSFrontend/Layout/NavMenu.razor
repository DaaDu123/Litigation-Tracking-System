@inject UserSessionState Session
@inject FirmAdminRequestStatusState FirmRequestStatus
@implements IDisposable
@using LTSFrontend.Features.FirmAdminRequests.Components
@using LTSFrontend.Features.FirmAdminRequests.DTOs
@using LTSFrontend.Features.FirmAdminRequests.Services

<nav>
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-speedometer2"></i> <span class="nav-label">Dashboard</span>
        </NavLink>
    </div>

    @if (string.IsNullOrEmpty(Session.Role))
    {
        <div class="nav-item">
            <NavLink class="nav-link" href="join-firm">
                <i class="bi bi-building-add"></i> <span class="nav-label">Join a Firm</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <a class="nav-link @(CreateFirmUnavailable ? "is-disabled" : "")" href="javascript:void(0)"
               aria-disabled="@(CreateFirmUnavailable ? "true" : null)"
               title="@CreateFirmTooltip"
               @onclick="OpenCreateFirmModalAsync">
                <i class="bi bi-plus-circle"></i> <span class="nav-label">Create Your Own Firm</span>
                @if (CreateFirmBadge is not null)
                {
                    <span class="lts-nav-status @CreateFirmBadge.Value.Css">@CreateFirmBadge.Value.Text</span>
                }
            </a>
        </div>
        <CreateFirmModal @ref="_createFirmModal" />
    }

    <AuthorizeView Roles="FirmAdmin,Partner,AssociateLawyer,Moharrir,InternParalegal">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="cases">
                    <i class="bi bi-briefcase"></i> <span class="nav-label">Cases</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="cases/my-assigned">
                    <i class="bi bi-person-check"></i> <span class="nav-label">My Assigned Cases</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="hearings">
                    <i class="bi bi-calendar-event"></i> <span class="nav-label">Hearings</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="deadlines">
                    <i class="bi bi-hourglass-split"></i> <span class="nav-label">Deadlines</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="FirmAdmin,Partner">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="users">
                    <i class="bi bi-people"></i> <span class="nav-label">Users</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="FirmAdmin">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="user-join-requests">
                    <i class="bi bi-person-plus"></i> <span class="nav-label">Join Requests</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="blocked-users">
                    <i class="bi bi-person-x-fill"></i> <span class="nav-label">Blocked Users</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="FirmAdmin,SuperAdmin">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="login-history">
                    <i class="bi bi-clock-history"></i> <span class="nav-label">Login History</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="SuperAdmin">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="firms">
                    <i class="bi bi-building"></i> <span class="nav-label">Firm Workspaces</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="firm-admin-requests">
                    <i class="bi bi-person-check"></i> <span class="nav-label">Firm Admin Requests</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="audit-logs">
                    <i class="bi bi-journal-check"></i> <span class="nav-label">Audit Logs</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="roles">
                    <i class="bi bi-shield-lock"></i> <span class="nav-label">Roles</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="permissions/matrix">
                    <i class="bi bi-grid-3x3-gap"></i> <span class="nav-label">Permissions</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="users/deleted">
                    <i class="bi bi-person-x"></i> <span class="nav-label">Deleted Users</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="FirmAdmin,Partner">
        <Authorized>
            <div class="nav-section-title">Configuration</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="masters" Match="NavLinkMatch.All">
                    <i class="bi bi-diagram-3"></i> <span class="nav-label">Master Data</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/courts">
                    <i class="bi bi-bank"></i> <span class="nav-label">Courts</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/case-categories">
                    <i class="bi bi-diagram-2"></i> <span class="nav-label">Case Categories</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/case-stages">
                    <i class="bi bi-signpost-split"></i> <span class="nav-label">Case Stages</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/case-statuses">
                    <i class="bi bi-flag"></i> <span class="nav-label">Case Statuses</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/departments">
                    <i class="bi bi-diagram-3"></i> <span class="nav-label">Departments</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/document-types">
                    <i class="bi bi-file-earmark-text"></i> <span class="nav-label">Document Types</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="nav-item">
        <NavLink class="nav-link" href="profile">
            <i class="bi bi-person-circle"></i> <span class="nav-label">My Profile</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="login-history/my">
            <i class="bi bi-clock-history"></i> <span class="nav-label">My Login History</span>
        </NavLink>
    </div>
</nav>

@code {
    private CreateFirmModal? _createFirmModal;

    protected override async Task OnInitializedAsync()
    {
        FirmRequestStatus.OnChange += HandleFirmRequestStatusChanged;

        // Only role-less users ever see the entry, so only they need the status.
        if (string.IsNullOrEmpty(Session.Role))
            await FirmRequestStatus.EnsureLoadedAsync();
    }

    private void HandleFirmRequestStatusChanged() => InvokeAsync(StateHasChanged);

    private bool CreateFirmUnavailable => FirmRequestStatus.Current is { CanSubmit: false };

    private string? CreateFirmTooltip => FirmRequestStatus.Current is { CanSubmit: false } c ? c.StatusMessage : null;

    private (string Text, string Css)? CreateFirmBadge => FirmRequestStatus.Current?.Phase switch
    {
        FirmRequestPhase.Pending => ("Pending", "is-pending"),
        FirmRequestPhase.Approved => ("Approved", "is-approved"),
        FirmRequestPhase.Rejected => ("Rejected", ""),
        _ => null
    };

    public void Dispose() => FirmRequestStatus.OnChange -= HandleFirmRequestStatusChanged;

    private async Task OpenCreateFirmModalAsync()
    {
        if (_createFirmModal is not null)
            await _createFirmModal.OpenAsync();
    }
}

