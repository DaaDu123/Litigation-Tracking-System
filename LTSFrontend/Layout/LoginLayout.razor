@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="public-shell">
    <PublicNavbar />

    <div class="auth-hero-section">
        <div class="auth-hero-left">
            <div class="auth-hero-rule"></div>
            <h1>Litigation Tracking System</h1>
            <p class="auth-hero-lead">
                Helping law firms and legal teams manage cases, hearings, documents, and
                deadlines &mdash; all in one secure platform.
            </p>

            <div class="hero-feature-grid">
                <div class="hero-feature-item">
                    <i class="bi bi-file-earmark-text"></i>
                    <h4>Case Management</h4>
                    <p>Track and manage cases efficiently</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-calendar-event"></i>
                    <h4>Hearing &amp; Deadlines</h4>
                    <p>Never miss a hearing or important date</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-folder2-open"></i>
                    <h4>Document Management</h4>
                    <p>Organize and access documents securely</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-bar-chart-line"></i>
                    <h4>Reports &amp; Analytics</h4>
                    <p>Get insights and make better decisions</p>
                </div>
            </div>
        </div>

        <div class="auth-hero-right">
            <section class="auth-form-card" aria-label="Account access">
                <div class="auth-form-content" @key="CurrentPath">
                    @Body
                </div>

                @if (ShowAuthSwitcher)
                {
                    <div class="auth-panel-switch">
                        @if (IsRegisterPage)
                        {
                            <span>Already have an account?</span>
                            <a href="/login">Sign in</a>
                        }
                        else
                        {
                            <span>Don't have an account?</span>
                            <a href="/register">Register</a>
                        }
                    </div>
                }
            </section>
        </div>
    </div>

    <PublicFooter />
</div>

@code {
    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
    private bool IsRegisterPage => string.Equals(CurrentPath, "/register", StringComparison.OrdinalIgnoreCase);
    private bool ShowAuthSwitcher =>
        IsRegisterPage || string.Equals(CurrentPath, "/login", StringComparison.OrdinalIgnoreCase);
}
