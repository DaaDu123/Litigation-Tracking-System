@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<div class="public-shell">
    <PublicNavbar />

    <div class="auth-hero-section">
        <div class="auth-hero-left">
            <div class="auth-hero-rule"></div>
            <h1>Litigation Tracking System</h1>
            <p class="auth-hero-lead">
                Helping law firms and legal teams manage cases, hearings, documents, and
                deadlines &mdash; all in one secure platform.
            </p>

            <div class="hero-feature-grid">
                <div class="hero-feature-item">
                    <i class="bi bi-file-earmark-text"></i>
                    <h4>Case Management</h4>
                    <p>Track and manage cases efficiently</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-calendar-event"></i>
                    <h4>Hearing &amp; Deadlines</h4>
                    <p>Never miss a hearing or important date</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-folder2-open"></i>
                    <h4>Document Management</h4>
                    <p>Organize and access documents securely</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-bar-chart-line"></i>
                    <h4>Reports &amp; Analytics</h4>
                    <p>Get insights and make better decisions</p>
                </div>
            </div>
        </div>

        <div class="auth-hero-right">
            <div class="auth-form-card">
                @Body
            </div>

            @* Bottom "pill" navigation - lets a visitor see and jump between
               the 3 auth pages (Sign In / Create Account / Request Firm
               Admin) without hunting for the small text links inside each
               form. Purely presentational: it mirrors NavigationManager's
               current URL and calls NavigateTo, so it never changes what
               each page itself does. Hidden on the other pages that also
               use this layout (Forgot/Reset Password, Verify OTP) - those
               aren't part of this 3-way choice and showing it there would
               just be confusing. *@
            @if (_showPager)
            {
                <nav class="auth-pager" aria-label="Auth page navigation">
                    <button type="button" class="auth-pager-arrow" @onclick="GoPrev" disabled="@(_currentIndex == 0)" aria-label="Previous page">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="auth-pager-label">
                        <span class="auth-pager-text" @key="_currentIndex">@_pages[_currentIndex].Label</span>
                        <span class="auth-pager-count">@(_currentIndex + 1) of @_pages.Length</span>
                    </div>

                    <button type="button" class="auth-pager-arrow" @onclick="GoNext" disabled="@(_currentIndex == _pages.Length - 1)" aria-label="Next page">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </nav>

                <div class="auth-pager-dots" role="tablist" aria-label="Jump to auth page">
                    @for (int i = 0; i < _pages.Length; i++)
                    {
                        var index = i;
                        <button type="button"
                                class="auth-pager-dot @(index == _currentIndex ? "active" : "")"
                                role="tab"
                                aria-selected="@(index == _currentIndex ? "true" : "false")"
                                title="@_pages[index].Label"
                                aria-label="@_pages[index].Label"
                                @onclick="() => GoTo(index)">
                        </button>
                    }
                </div>
                <p class="auth-pager-hint">Explore more options</p>
            }
        </div>
    </div>

    <PublicFooter />
</div>

@code {
    private sealed record AuthPage(string Path, string Label);

    // Order here also defines Prev/Next order - keep in sync with the
    // three @page routes under Features/Auth/Pages and
    // Features/FirmAdminRequests/Pages.
    private readonly AuthPage[] _pages =
    [
        new AuthPage("/login", "Sign In"),
        new AuthPage("/register", "Create Account"),
        new AuthPage("/request-firm-admin", "Request Firm Admin")
    ];

    private int _currentIndex;
    private bool _showPager;

    protected override void OnInitialized()
    {
        UpdateCurrentIndex();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateCurrentIndex();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentIndex()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var index = Array.FindIndex(_pages, p => string.Equals(p.Path, path, StringComparison.OrdinalIgnoreCase));
        _showPager = index >= 0;
        _currentIndex = index >= 0 ? index : 0;
    }

    private void GoPrev()
    {
        if (_currentIndex > 0)
            Nav.NavigateTo(_pages[_currentIndex - 1].Path);
    }

    private void GoNext()
    {
        if (_currentIndex < _pages.Length - 1)
            Nav.NavigateTo(_pages[_currentIndex + 1].Path);
    }

    private void GoTo(int index)
    {
        if (index != _currentIndex)
            Nav.NavigateTo(_pages[index].Path);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}

