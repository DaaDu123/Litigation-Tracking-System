@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject LTSFrontend.Core.Http.ApiClient ApiClient

@if (!_authReady)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <span class="spinner-border text-primary"></span>
    </div>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{ RedirectToAccessPage(); }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
                        <span class="spinner-border text-primary"></span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="p-4">
                    <h3>Page not found</h3>
                    <p class="text-muted">Sorry, there's nothing at this address.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _authReady;
    private bool _hasRegisteredAccounts;
    private bool _isAuthenticated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            if (!_isAuthenticated)
            {
                try
                {
                    var status = await ApiClient.GetAsync<RegistrationStatus>(LTSFrontend.Core.Http.ApiEndpoints.Auth.RegistrationStatus);
                    _hasRegisteredAccounts = status?.HasRegisteredAccounts ?? true;
                }
                catch
                {
                    // Fail closed: an unavailable status endpoint must never
                    // make a protected route appear accessible.
                    _hasRegisteredAccounts = true;
                }
            }
            _authReady = true;
            StateHasChanged();

            var currentPath = new Uri(Navigation.Uri).AbsolutePath;
            if (!_isAuthenticated)
            {
                if (currentPath == "/"
                    || (currentPath.Equals("/login", StringComparison.OrdinalIgnoreCase) && !_hasRegisteredAccounts)
                    || (currentPath.Equals("/register", StringComparison.OrdinalIgnoreCase) && _hasRegisteredAccounts))
                {
                    Navigation.NavigateTo(_hasRegisteredAccounts ? "/login" : "/register", replace: true);
                }
            }
            else if (currentPath.Equals("/login", StringComparison.OrdinalIgnoreCase)
                || currentPath.Equals("/register", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/", replace: true);
            }
        }
    }

    private void RedirectToAccessPage()
    {
        if (_isAuthenticated)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        Navigation.NavigateTo(_hasRegisteredAccounts ? "/login" : "/register", replace: true);
    }

    private sealed record RegistrationStatus(bool HasRegisteredAccounts);
}
