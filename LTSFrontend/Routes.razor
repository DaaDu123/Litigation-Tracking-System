@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject LTSFrontend.State.ProfileCompletionState ProfileState
@inject ILogger<Routes> Logger
@implements IDisposable

@if (!_authReady)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;" aria-label="Checking session">
        <span class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Checking session...</span>
        </span>
    </div>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{ RedirectToAccessPage(); }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
                        <span class="spinner-border text-primary" role="status"></span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="p-4">
                    <h3>Page not found</h3>
                    <p class="text-muted">Sorry, there's nothing at this address.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _authReady;
    private bool _isAuthenticated;
    private string? _redirectTarget;

    protected override void OnInitialized()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // ProtectedLocalStorage requires an interactive render, so restore/check the
        // session before allowing Router to render any protected page.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        // A session restored from browser storage is only a candidate until the
        // backend accepts an authenticated request. Keep Router hidden meanwhile.
        if (_isAuthenticated)
        {
            try
            {
                await ProfileState.EnsureLoadedAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Restored session validation failed; clearing it before routing.");
                var provider = (LTSFrontend.Core.Auth.CustomAuthStateProvider)AuthStateProvider;
                await provider.MarkUserAsLoggedOutAsync();
                ProfileState.Reset();
                _isAuthenticated = false;
            }
        }

        var currentUri = new Uri(Navigation.Uri);
        var currentPath = currentUri.AbsolutePath;

        if (_isAuthenticated &&
            (IsPath(currentPath, "/login") || IsPath(currentPath, "/register")))
        {
            RedirectAndWait("/");
            return;
        }
        else if (!_isAuthenticated && !IsPublicPath(currentPath))
        {
            // Do not expose the originally requested protected route during the
            // interval between requesting navigation and LocationChanged.
            RedirectAndWait("/login");
            return;
        }

        _authReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private void RedirectAndWait(string target)
    {
        _redirectTarget = target;
        Navigation.LocationChanged += HandleLocationChanged;
        Navigation.NavigateTo(target, replace: true);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (_redirectTarget is null || !IsPath(new Uri(args.Location).AbsolutePath, _redirectTarget))
            return;

        _redirectTarget = null;
        Navigation.LocationChanged -= HandleLocationChanged;
        _authReady = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleAuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        _ = InvokeAsync(async () =>
        {
            var state = await stateTask;
            _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            StateHasChanged();
        });
    }

    private static bool IsPath(string currentPath, string expectedPath) =>
        string.Equals(currentPath, expectedPath, StringComparison.OrdinalIgnoreCase);

    private static bool IsPublicPath(string path)
    {
        // Routes that are intentionally available without an authenticated session.
        string[] publicPaths =
        {
            "/login",
            "/register",
            "/forgot-password",
            "/reset-password",
            "/verify-otp",
            "/request-firm-admin",
            "/features",
            "/benefits",
            "/pricing",
            "/security",
            "/contact"
        };

        return publicPaths.Any(p => IsPath(path, p));
    }

    private void RedirectToAccessPage()
    {
        if (_isAuthenticated)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        Navigation.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
