@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@if (!_authReady)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <span class="spinner-border text-primary"></span>
    </div>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{ RedirectToAccessPage(); }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
                        <span class="spinner-border text-primary"></span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="p-4">
                    <h3>Page not found</h3>
                    <p class="text-muted">Sorry, there's nothing at this address.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _authReady;
    private bool _isAuthenticated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            var currentPath = new Uri(Navigation.Uri).AbsolutePath;
            if (_isAuthenticated && (currentPath.Equals("/login", StringComparison.OrdinalIgnoreCase)
                || currentPath.Equals("/register", StringComparison.OrdinalIgnoreCase)))
            {
                Navigation.NavigateTo("/", replace: true);
            }
            else if (!_isAuthenticated && currentPath == "/")
            {
                Navigation.NavigateTo("/login", replace: true);
            }

            _authReady = true;
            StateHasChanged();
        }
    }

    private void RedirectToAccessPage()
    {
        if (_isAuthenticated)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        var currentUri = new Uri(Navigation.Uri);
        var returnUrl = Uri.EscapeDataString(currentUri.PathAndQuery);
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", replace: true);
    }
}
