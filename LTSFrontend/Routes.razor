@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@if (!_authReady)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;" aria-label="Checking session">
        <span class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Checking session...</span>
        </span>
    </div>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{ RedirectToAccessPage(); }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
                        <span class="spinner-border text-primary" role="status"></span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="p-4">
                    <h3>Page not found</h3>
                    <p class="text-muted">Sorry, there's nothing at this address.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _authReady;
    private bool _isAuthenticated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // ProtectedLocalStorage requires an interactive render, so restore/check the
        // session before allowing Router to render any protected page.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        var currentUri = new Uri(Navigation.Uri);
        var currentPath = currentUri.AbsolutePath;

        if (_isAuthenticated &&
            (IsPath(currentPath, "/login") || IsPath(currentPath, "/register")))
        {
            Navigation.NavigateTo("/", replace: true);
        }
        else if (!_isAuthenticated && !IsPublicPath(currentPath))
        {
            // Redirect before Router/AuthorizeRouteView can render the requested
            // protected page (Dashboard, Cases, Masters, etc.).
            Navigation.NavigateTo("/login", replace: true);
        }

        _authReady = true;
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsPath(string currentPath, string expectedPath) =>
        string.Equals(currentPath, expectedPath, StringComparison.OrdinalIgnoreCase);

    private static bool IsPublicPath(string path)
    {
        // Routes that are intentionally available without an authenticated session.
        string[] publicPaths =
        {
            "/login",
            "/register",
            "/forgot-password",
            "/reset-password",
            "/verify-otp",
            "/request-firm-admin",
            "/features",
            "/benefits",
            "/pricing",
            "/security",
            "/contact"
        };

        return publicPaths.Any(p => IsPath(path, p));
    }

    private void RedirectToAccessPage()
    {
        if (_isAuthenticated)
        {
            Navigation.NavigateTo("/access-denied", replace: true);
            return;
        }

        Navigation.NavigateTo("/login", replace: true);
    }
}
