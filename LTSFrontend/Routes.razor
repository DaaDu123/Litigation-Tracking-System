@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject LTSFrontend.State.ProfileCompletionState ProfileState
@inject ILogger<Routes> Logger
@implements IDisposable

@if (!_authReady)
{
    @if (ShowLoginDuringStartup)
    {
        <LayoutView Layout="typeof(LTSFrontend.Layout.LoginLayout)">
            <LTSFrontend.Features.Auth.Pages.Login SuppressAuthenticatedRedirect="true" />
        </LayoutView>
    }
    else if (IsPublicPath(CurrentPath))
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;" aria-label="Loading page">
            <span class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </span>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;" aria-label="Checking session">
            <span class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking session...</span>
            </span>
        </div>
    }
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div></div>
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
                        <span class="spinner-border text-primary" role="status"></span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="p-4">
                    <h3>Page not found</h3>
                    <p class="text-muted">Sorry, there's nothing at this address.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _authReady;
    private bool _isAuthenticated;
    private bool _startupCheckComplete;
    private bool _redirectInProgress;
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private bool ShowLoginDuringStartup =>
        IsPath(CurrentPath, "/") || IsPath(CurrentPath, "/login") || !IsPublicPath(CurrentPath);

    protected override void OnInitialized()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_startupCheckComplete)
        {
            _startupCheckComplete = true;

            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

                if (_isAuthenticated)
                {
                    try
                    {
                        await ProfileState.EnsureLoadedAsync();
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Restored session validation failed; clearing it before routing.");
                        if (AuthStateProvider is LTSFrontend.Core.Auth.CustomAuthStateProvider provider)
                            await provider.MarkUserAsLoggedOutAsync();

                        ProfileState.Reset();
                        _isAuthenticated = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not restore authentication state; treating visitor as anonymous.");
                _isAuthenticated = false;
            }

            var path = CurrentPath;
            if (_isAuthenticated && (IsPath(path, "/login") || IsPath(path, "/register")))
            {
                NavigateOnce("/");
                return;
            }

            if (!_isAuthenticated && !IsPublicPath(path))
            {
                NavigateOnce("/login");
                return;
            }

            _authReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateOnce(string target)
    {
        if (_redirectInProgress)
            return;

        _redirectInProgress = true;
        // Navigation is only initiated after the first interactive render. This
        // avoids NavigationException during server prerendering.
        Navigation.NavigateTo(target, replace: true);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _redirectInProgress = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleAuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var state = await stateTask;
                _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Authentication state notification failed.");
            }
        });
    }

    private static bool IsPath(string currentPath, string expectedPath) =>
        string.Equals(currentPath, expectedPath, StringComparison.OrdinalIgnoreCase);

    private static bool IsPublicPath(string path)
    {
        string[] publicPaths =
        {
            "/login",
            "/register",
            "/forgot-password",
            "/reset-password",
            "/verify-otp",
            "/request-firm-admin",
            "/features",
            "/benefits",
            "/pricing",
            "/security",
            "/contact"
        };

        return publicPaths.Any(p => IsPath(path, p));
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
