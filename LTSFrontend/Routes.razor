@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@if (!_authReady)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <span class="spinner-border text-primary"></span>
    </div>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{ RedirectToLogin(); }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
                        <span class="spinner-border text-primary"></span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="p-4">
                    <h3>Page not found</h3>
                    <p class="text-muted">Sorry, there's nothing at this address.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _authReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthStateProvider.GetAuthenticationStateAsync();
            _authReady = true;
            StateHasChanged();
        }
    }

    private void RedirectToLogin()
    {
        var currentUri = new Uri(Navigation.Uri);
        var currentPath = currentUri.PathAndQuery;

        // Use the named login route as the default entry point. Preserve a
        // requested deep link so users still return to it after signing in.
        if (string.Equals(currentUri.AbsolutePath, "/", StringComparison.Ordinal))
        {
            Navigation.NavigateTo("/login", forceLoad: false, replace: true);
            return;
        }

        var returnUrl = Uri.EscapeDataString(currentPath);
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
    }
}
