@page "/register"
@layout LTSFrontend.Layout.LoginLayout
@using LTSFrontend.Features.Auth.DTOs
@using LTSFrontend.Features.Auth.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Register - LTS</PageTitle>

<h2>Create Account</h2>
<p class="auth-subtitle">Register with your email - you'll pick your firm and finish your profile after signing in.</p>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger py-2" role="alert" style="white-space: pre-line;">@_errorMessage</div>
}

<EditForm Model="_model" OnValidSubmit="HandleRegisterAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="register-email">Email</label>
        <input id="register-email" type="email" class="form-control" placeholder="Enter your email address"
               autocomplete="email" @bind="_model.Email" @bind:event="oninput" disabled="@_isBusy" required />
        <ValidationMessage For="() => _model.Email" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="register-password">Password</label>
        <div class="password-toggle-wrap">
            <input id="register-password" type="@(_showPassword ? "text" : "password")" class="form-control"
                   placeholder="8+ chars, mixed case, number & symbol" autocomplete="new-password"
                   @bind="_model.Password" @bind:event="oninput" disabled="@_isBusy" required />
            <button type="button" class="password-toggle-btn" aria-label="@(_showPassword ? "Hide password" : "Show password")"
                    aria-pressed="@_showPassword" @onclick="() => _showPassword = !_showPassword">
                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
            </button>
        </div>
        <ValidationMessage For="() => _model.Password" class="text-danger small" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="register-confirm-password">Confirm Password</label>
        <div class="password-toggle-wrap">
            <input id="register-confirm-password" type="@(_showConfirmPassword ? "text" : "password")" class="form-control"
                   placeholder="Re-enter your password" autocomplete="new-password"
                   @bind="_model.ConfirmPassword" @bind:event="oninput" disabled="@_isBusy" required />
            <button type="button" class="password-toggle-btn" aria-label="@(_showConfirmPassword ? "Hide confirmation password" : "Show confirmation password")"
                    aria-pressed="@_showConfirmPassword" @onclick="() => _showConfirmPassword = !_showConfirmPassword">
                <i class="bi @(_showConfirmPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
            </button>
        </div>
        <ValidationMessage For="() => _model.ConfirmPassword" class="text-danger small" />
    </div>

    <button type="submit" class="btn btn-auth-primary" disabled="@_isBusy">
        @if (_isBusy)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
        }
        Register
    </button>
</EditForm>


@code {
    private readonly RegisterRequest _model = new();
    private bool _isBusy;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/", replace: true);
    }

    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var result = await AuthService.RegisterAsync(_model);
            Navigation.NavigateTo($"/verify-otp?email={Uri.EscapeDataString(result.Email)}");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Registration could not be completed. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
