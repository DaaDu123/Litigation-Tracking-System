@page "/login"
@layout LTSFrontend.Layout.LoginLayout
@using LTSFrontend.Core.Auth
@using LTSFrontend.Features.Auth.DTOs
@using LTSFrontend.Features.Auth.Services
@using LTSFrontend.Features.Users.Services
@inject IAuthService AuthService
@inject IUserService UserService
@inject UserSessionState Session
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - LTS</PageTitle>

<h2>Welcome Back!</h2>
<p class="auth-subtitle">Sign in to continue</p>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
}

<EditForm Model="_model" FormName="LoginForm" OnValidSubmit="HandleLoginAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="login-email">Email / Username</label>
        <input id="login-email" type="email" class="form-control" placeholder="Enter your email address"
               autocomplete="username" @bind="_model.Email" @bind:event="oninput" required />
        <ValidationMessage For="() => _model.Email" class="text-danger small" />
    </div>

    <div class="mb-2">
        <label class="form-label" for="login-password">Password</label>
        <div class="password-toggle-wrap">
            <input id="login-password" type="@(_showPassword ? "text" : "password")" class="form-control"
                   placeholder="Enter your password" autocomplete="current-password"
                   @bind="_model.Password" @bind:event="oninput" required />
            <button type="button" class="password-toggle-btn" aria-label="@(_showPassword ? "Hide password" : "Show password")"
                    aria-pressed="@_showPassword" @onclick="() => _showPassword = !_showPassword">
                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
            </button>
        </div>
        <ValidationMessage For="() => _model.Password" class="text-danger small" />
    </div>

    <div class="text-end mb-3">
        <a class="auth-link" href="/forgot-password">Forgot Password?</a>
    </div>

    <button type="submit" class="btn btn-auth-primary" disabled="@_isBusy">
        @if (_isBusy)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
        }
        Sign In
    </button>
</EditForm>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private readonly LoginRequest _model = new();
    private bool _isBusy;
    private bool _showPassword;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/", replace: true);
    }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var result = await AuthService.LoginAsync(_model);

            var provider = (CustomAuthStateProvider)AuthStateProvider;


            await provider.MarkUserAsAuthenticatedAsync(result.UserID, result.FullName, result.Email, result.RoleName, result.AccessToken, result.AccessTokenExpiry);






            Navigation.NavigateTo(GetSafeReturnUrl());
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Could not Login. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string GetSafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl)
            || !ReturnUrl.StartsWith("/", StringComparison.Ordinal)
            || ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            || ReturnUrl.Contains('\\'))
        {
            return "/";
        }

        return ReturnUrl;
    }
}
