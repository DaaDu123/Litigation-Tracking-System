@* Presentational table of users, built on the shared generic DataTable so
   loading/empty/error states match every other list in the app (see
   RoleList.razor). The caller owns data loading, search, and pagination -
   this component only renders the given page of users and raises callbacks.
   No general "Edit" action is exposed here: a Firm Admin may only change a
   user's role (ChangeRoleModal) or lifecycle status (activate/deactivate/
   block/remove/delete) - never another person's name, contact info, or
   profile photo, which only that person can edit for themselves.
   Usage:
     <UserTable Users="PagedUsers" IsLoading="_isLoading" HasError="_hasError"
                ErrorMessage="_errorMessage" OnRetry="LoadAsync" CanManage="CanManageUsers"
                CurrentUserId="Session.UserID" OnDelete="HandleDeleteAsync" /> *@
@using LTSFrontend.Features.Users.DTOs

<DataTable TItem="UserDTO" Items="Users" IsLoading="IsLoading" HasError="HasError"
           ErrorMessage="ErrorMessage" OnRetry="OnRetry"
           EmptyIcon="bi-people" EmptyTitle="@(HasActiveFilters ? "No matching users" : "No users yet")"
           EmptyDescription="@(HasActiveFilters ? "Try adjusting your search." : "Add your first user to get started.")"
           SkeletonColumnCount="@(CanManage ? 6 : 5)">
    <HeaderContent>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Status</th>
        <th>Membership</th>
        @if (CanManage)
        {
            <th class="text-end">Actions</th>
        }
    </HeaderContent>
    <RowTemplate Context="user">
        <td class="lts-cell-primary">
            <a href="/users/details/@user.UserID">@user.FullName</a>
        </td>
        <td class="lts-cell-muted">@user.Email</td>
        <td>@(string.IsNullOrWhiteSpace(user.RoleName) ? "-" : LTSFrontend.Core.Enums.UserRoleExtensions.DisplayName(user.RoleName))</td>
        <td><StatusBadge IsActive="user.IsActive" /></td>
        <td>
            @switch (user.MembershipStatus)
            {
                case "Blocked":
                    <span class="badge bg-danger">Blocked</span>
                    break;
                case "Removed":
                    <span class="badge bg-secondary">Removed</span>
                    break;
                default:
                    @if (user.RoleName == "FirmAdmin")
                    {
                        @if (user.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Inactive</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    break;
            }
        </td>
        @if (CanManage)
        {
            <td class="text-end">
                <div class="lts-row-actions">
                    @if (user.IsActive)
                    {
                        <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Deactivate (reversible - blocks sign-in, keeps the account)"
                                disabled="@(user.UserID == CurrentUserId)"
                                @onclick="() => OnDeactivate.InvokeAsync(user)">
                            <i class="bi bi-slash-circle text-warning"></i>
                        </button>
                    }
                    else
                    {
                        <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Activate (restore sign-in access)"
                                @onclick="() => OnActivate.InvokeAsync(user)">
                            <i class="bi bi-check-circle text-success"></i>
                        </button>
                    }

                    @if (user.RoleName != "FirmAdmin" && user.UserID != CurrentUserId)
                    {
                        <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Change Role"
                                @onclick="() => OnChangeRole.InvokeAsync(user)">
                            <i class="bi bi-person-gear"></i>
                        </button>

                        @if (user.MembershipStatus == "Blocked")
                        {
                            <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Unblock"
                                    @onclick="() => OnUnblock.InvokeAsync(user)">
                                <i class="bi bi-unlock text-success"></i>
                            </button>
                        }
                        else
                        {
                            <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Block from this firm"
                                    @onclick="() => OnBlock.InvokeAsync(user)">
                                <i class="bi bi-lock text-danger"></i>
                            </button>
                        }

                        <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Remove from this firm"
                                @onclick="() => OnRemove.InvokeAsync(user)">
                            <i class="bi bi-person-dash text-danger"></i>
                        </button>
                    }

                    <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Delete permanently (cannot be undone)"
                            disabled="@(user.UserID == CurrentUserId)"
                            @onclick="() => OnDelete.InvokeAsync(user)">
                        <i class="bi bi-trash text-danger"></i>
                    </button>
                </div>
            </td>
        }
    </RowTemplate>
</DataTable>

@code {
    [Parameter, EditorRequired] public IEnumerable<UserDTO>? Users { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    /// <summary>Whether the current viewer (FirmAdmin/SuperAdmin) can edit/deactivate users - hides the Actions column entirely when false.</summary>
    [Parameter] public bool CanManage { get; set; }

    /// <summary>The signed-in user's own ID, so they can't deactivate/block/remove themselves from the table.</summary>
    [Parameter] public int CurrentUserId { get; set; }

    [Parameter] public bool HasActiveFilters { get; set; }

    /// <summary>Reversible: sets IsActive = false. User keeps showing in the list and can be turned back on.</summary>
    [Parameter] public EventCallback<UserDTO> OnDeactivate { get; set; }

    /// <summary>Reverses Deactivate: sets IsActive = true again.</summary>
    [Parameter] public EventCallback<UserDTO> OnActivate { get; set; }

    /// <summary>Permanent, irreversible removal. Frees up the user's email for reuse.</summary>
    [Parameter] public EventCallback<UserDTO> OnDelete { get; set; }

    /// <summary>Locks the user out of the firm entirely (reversible via OnUnblock).</summary>
    [Parameter] public EventCallback<UserDTO> OnBlock { get; set; }

    /// <summary>Restores a previously blocked user's access.</summary>
    [Parameter] public EventCallback<UserDTO> OnUnblock { get; set; }

    /// <summary>Detaches the user from the firm entirely (distinct from Block) - a mandatory reason is required.</summary>
    [Parameter] public EventCallback<UserDTO> OnRemove { get; set; }

    /// <summary>Opens the role-change modal for this user.</summary>
    [Parameter] public EventCallback<UserDTO> OnChangeRole { get; set; }
}
