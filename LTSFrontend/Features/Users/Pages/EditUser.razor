@page "/users/edit/{UserId:int}"
@attribute [Authorize(Roles = "FirmAdmin")]
@using LTSFrontend.Core.Enums
@using LTSFrontend.Features.Users.DTOs
@using LTSFrontend.Features.Users.Services
@inject IUserService UserService
@inject NavigationManager Navigation
@inject UserSessionState Session

<PageTitle>Edit User - LTS</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <button class="btn btn-sm btn-outline-secondary" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i>
    </button>
    <h4 class="mb-0">Edit User</h4>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" style="white-space: pre-line;">@_errorMessage</div>
}

@if (_isLoading)
{
    <p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading user...</p>
}
else if (_model != null)
{
    <div class="lts-card" style="max-width: 640px;">
        <EditForm Model="_model" OnValidSubmit="HandleUpdateAsync">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" @bind="_model.FullName" @bind:event="oninput" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="_model.Email" @bind:event="oninput" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Role</label>
                    <select class="form-select" @bind="_model.RoleID">
                        <option value="">-- Select Role --</option>
                        @foreach (var role in _roleOptions)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="_model.IsActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="text" class="form-control" @bind="_model.Phone" @bind:event="oninput" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Department <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="text" class="form-control" @bind="_model.Department" @bind:event="oninput" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Profile Image <span class="text-muted fw-normal">(optional - leave blank to keep current)</span></label>
                <InputFile class="form-control" OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                    @if (_isBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Save Changes
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int UserId { get; set; }

    private CreateUserDTO? _model;
    private IBrowserFile? _profileImage;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _errorMessage;

    // Firm Admin can only assign Partner/AssociateLawyer/Moharrir/InternParalegal
    // (mirrors the backend RoleHierarchy fix - "Firm Admin cannot create/assign
    // another Firm Admin"). If the user being edited already holds a role outside
    // that set (e.g. they're the workspace's FirmAdmin), keep it in the list so
    // the dropdown doesn't silently drop/corrupt their existing role - the
    // backend will still reject any attempt to actually change it to that role.
    // Mirrors UserFormModal.razor: the acting user (currently FirmAdmin
    // only reaches this page) can only assign a role that is strictly
    // lower privilege than their own - see RoleHierarchy.CanAssignRole on
    // the backend. Using the dynamic AssignableBy(Session.Role) instead of
    // the old static AssignableByFirmAdmin keeps this page correct
    // automatically if this page's own [Authorize(Roles=...)] is ever
    // widened, same as UserFormModal already does.
    private List<(int Id, string Name)> _roleOptions = new();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _roleOptions = UserRoleExtensions.AssignableBy(Session.Role).ToList();
        try
        {
            var user = await UserService.GetByIdAsync(UserId);
            if (user == null)
            {
                _errorMessage = "User not found.";
                return;
            }

            _model = new CreateUserDTO
            {
                UserID = user.UserID,
                FullName = user.FullName,
                Email = user.Email,
                Phone = user.Phone,
                Department = user.Department,
                RoleID = user.RoleID,
                IsActive = user.IsActive
            };

            if (user.RoleID.HasValue && !_roleOptions.Any(r => r.Id == user.RoleID.Value))
            {
                _roleOptions = new List<(int Id, string Name)>(_roleOptions)
                {
                    (user.RoleID.Value, UserRoleExtensions.NameOf(user.RoleID.Value))
                };
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "User load nahi ho saka. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _profileImage = e.File;
    }

    private async Task HandleUpdateAsync()
    {
        if (_model == null)
            return;

        _errorMessage = null;

        if (_model.RoleID is null or <= 0)
        {
            _errorMessage = "Please select a role.";
            return;
        }

        _isBusy = true;
        try
        {
            await UserService.UpdateAsync(_model, _profileImage);
            Navigation.NavigateTo("/users");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/users");
}
