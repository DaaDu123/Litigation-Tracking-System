@page "/users"
@attribute [Authorize(Roles = "FirmAdmin,Partner")]
@using LTSFrontend.Features.Users.Components
@using LTSFrontend.Features.Users.DTOs
@using LTSFrontend.Features.Users.Services
@inject IUserService UserService
@inject UserSessionState Session
@inject ToastService Toast

<PageTitle>User Management - LTS</PageTitle>

<div class="lts-page-header">
    <div>
        <h1 class="lts-page-title">User Management</h1>
        <p class="lts-page-subtitle">Manage the people in your firm's workspace and the roles they hold.</p>
    </div>
    @if (CanCreateUsers)
    {
        <div class="lts-page-header-actions">
            <button class="lts-btn lts-btn-primary" @onclick="OpenCreateAsync">
                <i class="bi bi-plus-lg"></i> Add User
            </button>
        </div>
    }
</div>

<div class="lts-stat-grid">
    <div class="lts-stat-card" style="--accent:#1b4fd6;">
        <div class="lts-stat-icon"><i class="bi bi-people"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _users.Count.ToString())</div>
            <div class="lts-stat-label">Total Users</div>
        </div>
    </div>
    <div class="lts-stat-card" style="--accent:#16a34a;">
        <div class="lts-stat-icon"><i class="bi bi-person-check"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _users.Count(u => u.IsActive).ToString())</div>
            <div class="lts-stat-label">Active</div>
        </div>
    </div>
</div>

<div class="lts-card p-0">
    <div class="lts-toolbar" style="padding: 1rem 1.1rem 0;">
        <div class="lts-toolbar-left">
            <SearchBox @bind-Value="_searchTerm" @bind-Value:after="HandleSearchChangedAsync"
                       Placeholder="Search by name or contact number..." />
        </div>
        <div class="lts-toolbar-right">
            <button class="lts-btn lts-btn-outline lts-btn-sm" @onclick="LoadAsync" title="Refresh" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise @(_isLoading ? "spin" : "")"></i>
            </button>
        </div>
    </div>

    <div style="padding: 1rem 1.1rem;">
        <UserTable Users="PagedUsers" IsLoading="_isLoading" HasError="_hasError" ErrorMessage="_errorMessage"
                   OnRetry="LoadAsync" CanManage="CanManageUsers" CurrentUserId="Session.UserID"
                   HasActiveFilters="!string.IsNullOrWhiteSpace(_searchTerm)"
                   OnDeactivate="HandleDeactivateAsync" OnActivate="HandleActivateAsync" OnDelete="HandlePermanentDeleteAsync"
                   OnBlock="HandleBlockAsync" OnUnblock="HandleUnblockAsync" OnRemove="HandleRemoveAsync" OnChangeRole="HandleChangeRoleAsync" />

        @if (!_isLoading && !_hasError && _users.Count > 0)
        {
            <Pagination CurrentPage="_currentPage" TotalItems="_users.Count" PageSize="_pageSize" PageChanged="OnPageChanged" />
        }
    </div>
</div>

<UserFormModal @ref="_formModal" OnSaved="HandleSavedAsync" />
<ConfirmDialog @ref="_confirmDialog" />
<ReasonRequiredModal @ref="_blockModal" OnConfirmed="HandleBlockConfirmedAsync" />
<ReasonRequiredModal @ref="_removeModal" OnConfirmed="HandleRemoveConfirmedAsync" />
<ChangeRoleModal @ref="_roleModal" OnConfirmed="HandleRoleConfirmedAsync" />

@code {
    private List<UserDTO> _users = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;
    private bool _hasError;
    private string? _errorMessage;

    private int _currentPage = 1;
    private readonly int _pageSize = 10;

    private UserFormModal _formModal = default!;
    private ConfirmDialog _confirmDialog = default!;
    private ReasonRequiredModal _blockModal = default!;
    private ReasonRequiredModal _removeModal = default!;
    private ChangeRoleModal _roleModal = default!;

    /// <summary>
    /// Gates Edit/Deactivate/Activate/PermanentDelete/Block/Remove/Role
    /// (the Actions column in UserTable). FirmAdmin-only: Partner CAN view
    /// this page/list (see the page's own @attribute above, now
    /// "FirmAdmin,Partner") but has NO Create/Update/Delete access to
    /// users - view-only. SuperAdmin is likewise excluded: firm user
    /// management is the firm's own domain, not the platform owner's.
    /// </summary>
    private bool CanManageUsers => Session.Role is "FirmAdmin";

    /// <summary>
    /// Gates the "Add User" button. Same FirmAdmin-only rule as
    /// CanManageUsers above (matches UsersController.Create's
    /// [Authorize(Roles = RoleNames.FirmAdminOnly)] on the backend).
    /// </summary>
    private bool CanCreateUsers => Session.Role is "FirmAdmin";

    private List<UserDTO> PagedUsers =>
        _users.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _hasError = false;
        _errorMessage = null;
        try
        {
            // Server-side search (per spec) - never fetches the full firm
            // directory just to filter it client-side.
            _users = await UserService.GetAllAsync(_searchTerm);
        }
        catch (ApiException ex)
        {
            _hasError = true;
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _hasError = true;
            _errorMessage = "Users could not be loaded. Please check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearchChangedAsync()
    {
        _currentPage = 1;
        await LoadAsync();
    }

    private void OnPageChanged(int page) => _currentPage = page;

    private Task OpenCreateAsync() => _formModal.OpenForCreateAsync();

    private async Task HandleSavedAsync(bool wasEdit)
    {
        await LoadAsync();
        Toast.Success("User created", "The new user can now sign in with their password.");
    }

    private async Task HandleDeactivateAsync(UserDTO user)
    {
        if (user.UserID == Session.UserID)
            return;

        var confirmed = await _confirmDialog.ShowAsync(
            $"Deactivate \"{user.FullName}\"?",
            "They will no longer be able to sign in. This is reversible — you can reactivate them anytime from this same list.",
            "Deactivate", "danger");

        if (!confirmed) return;

        try
        {
            await UserService.DeleteAsync(user.UserID);
            await LoadAsync();
            Toast.Success("User deactivated", $"\"{user.FullName}\" can no longer sign in, but their account is still here.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't deactivate user", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't deactivate user", "Please try again.");
        }
    }

    private async Task HandleActivateAsync(UserDTO user)
    {
        try
        {
            await UserService.ActivateAsync(user.UserID);
            await LoadAsync();
            Toast.Success("User activated", $"\"{user.FullName}\" can sign in again.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't activate user", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't activate user", "Please try again.");
        }
    }

    private async Task HandlePermanentDeleteAsync(UserDTO user)
    {
        if (user.UserID == Session.UserID)
            return;

        var confirmed = await _confirmDialog.ShowAsync(
            $"Permanently delete \"{user.FullName}\"?",
            "This cannot be undone. They will disappear from this list forever, and their email will become free to use again for a new user.",
            "Delete permanently", "danger");

        if (!confirmed) return;

        try
        {
            await UserService.PermanentDeleteAsync(user.UserID);
            await LoadAsync();
            Toast.Success("User deleted", $"\"{user.FullName}\" has been permanently removed.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't delete user", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't delete user", "Please try again.");
        }
    }

    private Task HandleBlockAsync(UserDTO user)
    {
        _blockModal.Open(user.UserID, $"Block \"{user.FullName}\"?",
            "This user will no longer be able to access or see this firm.", "Block", "danger");
        return Task.CompletedTask;
    }

    private async Task HandleBlockConfirmedAsync((int UserId, string Reason) args)
    {
        try
        {
            await UserService.BlockAsync(args.UserId, args.Reason);
            await LoadAsync();
            Toast.Success("User blocked", "They can no longer access this firm.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't block user", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't block user", "Please try again.");
        }
    }

    private async Task HandleUnblockAsync(UserDTO user)
    {
        var confirmed = await _confirmDialog.ShowAsync(
            $"Unblock \"{user.FullName}\"?",
            "They will regain their previous access to this firm.",
            "Unblock", "warning");

        if (!confirmed) return;

        try
        {
            await UserService.UnblockAsync(user.UserID);
            await LoadAsync();
            Toast.Success("User unblocked", $"\"{user.FullName}\" can access the firm again.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't unblock user", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't unblock user", "Please try again.");
        }
    }

    private Task HandleRemoveAsync(UserDTO user)
    {
        _removeModal.Open(user.UserID, $"Remove \"{user.FullName}\" from the firm?",
            "They will no longer belong to this firm and will be free to request another firm. Please provide a reason.",
            "Remove", "danger");
        return Task.CompletedTask;
    }

    private async Task HandleRemoveConfirmedAsync((int UserId, string Reason) args)
    {
        try
        {
            await UserService.RemoveAsync(args.UserId, args.Reason);
            await LoadAsync();
            Toast.Success("User removed", "They no longer belong to this firm.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't remove user", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't remove user", "Please try again.");
        }
    }

    private Task HandleChangeRoleAsync(UserDTO user)
    {
        _roleModal.Open(user);
        return Task.CompletedTask;
    }

    private async Task HandleRoleConfirmedAsync((int UserId, int NewRoleId) args)
    {
        try
        {
            await UserService.ChangeRoleAsync(args.UserId, args.NewRoleId);
            await LoadAsync();
            Toast.Success("Role updated", "The user's role has been changed.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't change role", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't change role", "Please try again.");
        }
    }
}
