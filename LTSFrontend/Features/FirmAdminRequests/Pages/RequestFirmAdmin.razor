@page "/request-firm-admin"
@layout LTSFrontend.Layout.LoginLayout
@using LTSFrontend.Features.FirmAdminRequests.DTOs
@using LTSFrontend.Features.FirmAdminRequests.Services
@inject IFirmAdminRequestService FirmAdminRequestService
@inject NavigationManager Navigation

<PageTitle>Request Firm Admin Access - LTS</PageTitle>

@if (_submitted)
{
    <h2>Request Submitted</h2>

    <div class="alert alert-success py-2">
        Your request has been sent to a Super Admin for review.
        You'll receive an email once it's approved (or if it's declined). After approval, log in and you'll be
        asked to complete your profile and set up your firm's details. You can close this page now.
    </div>

    <div class="auth-footer">
        <a class="auth-link" href="/login">Back to Login</a>
    </div>
}
else
{
    <h2>Request Firm Admin Access</h2>
    <p class="auth-subtitle">Register with your email - you'll set up your firm's name and details after a Super Admin approves your request.</p>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger py-2" style="white-space: pre-line;">@_errorMessage</div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Your Email</label>
            <input type="email" class="form-control" placeholder="Enter your email address"
                   @bind="_model.Email" @bind:event="oninput" disabled="@_isBusy" required />
            <ValidationMessage For="() => _model.Email" class="text-danger small" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Password</label>
                <div class="password-toggle-wrap">
                    <input type="@(_showPassword ? "text" : "password")" class="form-control"
                           placeholder="8+ chars, mixed case, number & symbol"
                           @bind="_model.Password" @bind:event="oninput" disabled="@_isBusy" required />
                    <button type="button" class="password-toggle-btn" tabindex="-1" @onclick="() => _showPassword = !_showPassword">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => _model.Password" class="text-danger small" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Confirm Password</label>
                <div class="password-toggle-wrap">
                    <input type="@(_showConfirmPassword ? "text" : "password")" class="form-control"
                           placeholder="Re-enter your password"
                           @bind="_model.ConfirmPassword" @bind:event="oninput" disabled="@_isBusy" required />
                    <button type="button" class="password-toggle-btn" tabindex="-1" @onclick="() => _showConfirmPassword = !_showConfirmPassword">
                        <i class="bi @(_showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => _model.ConfirmPassword" class="text-danger small" />
            </div>
        </div>

        <button type="submit" class="btn btn-auth-primary" disabled="@_isBusy">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            Submit Request
        </button>
    </EditForm>

    <div class="auth-footer">
        Already have an account? <a class="auth-link" href="/login">Sign in</a>
    </div>
    <div class="auth-footer">
        Joining an existing firm instead? <a class="auth-link" href="/register">Create a Firm User account</a>
    </div>
}

@code {
    private readonly SubmitFirmAdminRequest _model = new();
    private bool _isBusy;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private string? _errorMessage;
    private bool _submitted;

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            await FirmAdminRequestService.SubmitAsync(_model);
            _submitted = true;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Could not submit your request. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
