@using LTSFrontend.Features.FirmAdminRequests.DTOs
@using LTSFrontend.Features.FirmAdminRequests.Services
@using LTSFrontend.Core.Exceptions
@implements IDisposable
@inject IFirmAdminRequestService FirmAdminRequestService
@inject FirmAdminRequestStatusState Status
@inject State.ToastService Toast

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="Close"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true" aria-hidden="@(_isOpen ? "false" : "true")">
    <div class="lts-modal lts-modal-sm" @onclick:stopPropagation="true">

        @if (_isRefreshing || Status.Current is null)
        {
            <div class="lts-modal-body text-center py-4">
                <span class="spinner-border spinner-border-sm me-2"></span> Checking request status...
            </div>
        }
        else if (_justSubmitted)
        {
            <div class="lts-modal-header">
                <div class="lts-modal-icon lts-modal-icon-primary">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <h5 class="lts-modal-title">Request submitted</h5>
                    <p class="lts-modal-subtitle mb-0">@FirmAdminRequestRules.PendingMessage</p>
                </div>
            </div>
            <div class="lts-modal-body">
                <p class="mb-0">
                    Your request has been sent to a Super Admin for review. You'll receive an email once it's approved
                    (or if it's declined). After approval, you'll be asked to set up your firm's name and details.
                </p>
            </div>
            <div class="lts-modal-footer">
                <button type="button" class="lts-btn lts-btn-primary" @onclick="Close">Got it</button>
            </div>
        }
        else if (!Status.Current.CanSubmit)
        {
            @* Pending, Approved, or blocked by a Super Admin request: explain, don't offer a submit. *@
            <div class="lts-modal-header">
                <div class="lts-modal-icon lts-modal-icon-primary">
                    <i class="bi bi-building-add"></i>
                </div>
                <div>
                    <h5 class="lts-modal-title">Create Your Own Firm</h5>
                    <p class="lts-modal-subtitle mb-0">Request Firm Admin access</p>
                </div>
            </div>
            <div class="lts-modal-body">
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger py-2 mb-3" style="white-space: pre-line;">@_errorMessage</div>
                }
                <FirmAdminRequestStatusBanner Eligibility="Status.Current!" />
            </div>
            <div class="lts-modal-footer">
                <button type="button" class="lts-btn lts-btn-ghost" @onclick="Close" disabled="@_isBusy">Close</button>
                @if (Status.Current.Phase == FirmRequestPhase.Pending && Status.Current.LatestRequest is not null)
                {
                    <button type="button" class="lts-btn lts-btn-danger" @onclick="CancelRequestAsync" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Cancel Request
                    </button>
                }
            </div>
        }
        else
        {
            <div class="lts-modal-header">
                <div class="lts-modal-icon lts-modal-icon-primary">
                    <i class="bi bi-building-add"></i>
                </div>
                <div>
                    <h5 class="lts-modal-title">Create Your Own Firm</h5>
                    <p class="lts-modal-subtitle mb-0">Request Firm Admin access</p>
                </div>
            </div>

            <div class="lts-modal-body">
                @if (Status.Current.Phase == FirmRequestPhase.Rejected)
                {
                    <div class="mb-3">
                        <FirmAdminRequestStatusBanner Eligibility="Status.Current!" />
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger py-2 mb-3" style="white-space: pre-line;">@_errorMessage</div>
                }
                <p class="mb-0">
                    This sends a request to a Super Admin to turn your existing account into a Firm Admin and set up
                    a new firm workspace under it. You'll keep signing in with the same email and password you use
                    today - nothing about your account needs to be re-entered. Until it's approved you stay a regular user.
                </p>
            </div>

            <div class="lts-modal-footer">
                <button type="button" class="lts-btn lts-btn-ghost" @onclick="Close" disabled="@_isBusy">Cancel</button>
                <button type="button" class="lts-btn lts-btn-primary" @onclick="SubmitAsync" disabled="@_isBusy">
                    @if (_isBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-send"></i> Submit Request
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool _isOpen;
    private bool _isBusy;
    private bool _isRefreshing;
    private bool _justSubmitted;
    private string? _errorMessage;

    protected override void OnInitialized() => Status.OnChange += HandleStatusChanged;

    private void HandleStatusChanged() => InvokeAsync(StateHasChanged);

    public async Task OpenAsync()
    {
        _isOpen = true;
        _justSubmitted = false;
        _errorMessage = null;
        _isRefreshing = true;
        StateHasChanged();

        try
        {
            // Fresh status every time it opens - the request may have been
            // approved/rejected (or a conflicting one created) since the page loaded.
            await Status.RefreshAsync();
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        if (Status.Current is { CanSubmit: false })
            return;

        _errorMessage = null;
        _isBusy = true;
        try
        {
            await FirmAdminRequestService.SubmitFromAccountAsync();
            _justSubmitted = true;
            Toast.Success("Request submitted", "A Super Admin will review your request shortly.");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Could not submit your request. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
        await Status.RefreshAsync();
    }

    // Withdraws the user's OWN pending request to the Super Admin, which frees
    // their single access-request slot (they may then request a Firm Admin instead).
    private async Task CancelRequestAsync()
    {
        var pending = Status.Current?.LatestRequest;
        if (pending is null)
            return;

        _errorMessage = null;
        _isBusy = true;
        try
        {
            await FirmAdminRequestService.CancelAsync(pending.RequestID);
            Toast.Success("Request cancelled", "You can now request a Firm Admin or send a new request.");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Could not cancel your request. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
        await Status.RefreshAsync();
    }

    public void Dispose() => Status.OnChange -= HandleStatusChanged;
}
