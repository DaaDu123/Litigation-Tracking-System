










@if (ShouldShow)
{
    <div class="lts-form-error mb-3" style="background: var(--lts-danger-bg); padding: 0.6rem 0.85rem; border-radius: var(--lts-radius-sm);">
        <i class="bi bi-exclamation-circle-fill"></i>
        <div>
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class="fw-semibold">@Title</div>
            }
            <ValidationSummary />
        </div>
    </div>
}

@code {

    [Parameter] public string? Title { get; set; }

    [CascadingParameter] private EditContext? CurrentEditContext { get; set; }




    private bool ShouldShow => CurrentEditContext is not null && CurrentEditContext.GetValidationMessages().Any();
}
