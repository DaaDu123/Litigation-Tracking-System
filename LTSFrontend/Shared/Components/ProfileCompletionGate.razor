@using LTSFrontend.Core.Auth
@using LTSFrontend.Features.Auth.Services
@using LTSFrontend.Features.Profile.DTOs
@using LTSFrontend.Features.Profile.Services
@using LTSFrontend.Shared.Validation
@using LTSFrontend.State
@using LTSFrontend.Layout
@inject ProfileCompletionState ProfileState
@inject UserSessionState Session
@inject IProfileService ProfileService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="public-shell">
    <header class="public-navbar">
        <span class="public-navbar-brand">
            <img src="images/justice-scale-logo.png" alt="Litigation Tracking System" />
            <span class="public-navbar-brand-text">
                <span class="brand-title">LITIGATION TRACKING SYSTEM</span>
                <span class="brand-subtitle">MANAGE. MONITOR. RESOLVE.</span>
            </span>
        </span>

        <div class="public-navbar-actions ms-auto">
            <button class="public-navbar-theme-btn" type="button" title="Toggle theme" @onclick="ToggleThemeAsync">
                <i class="bi @(_isDarkTheme ? "bi-sun" : "bi-moon-stars")"></i>
            </button>
            <button type="button" class="lts-btn lts-btn-outline lts-btn-sm" @onclick="HandleLogoutAsync" disabled="@_isBusy">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </div>
    </header>

    <div class="auth-hero-section">
        <div class="auth-hero-left">
            <div class="auth-hero-rule"></div>
            <h1>One last step <span class="text-gold">before you're in</span></h1>
            <p class="auth-hero-lead">
                @(IsFirmAdmin
                    ? "Your account has been approved. Complete your profile and firm details to set up your workspace and unlock your dashboard."
                    : "Complete your profile so we can get you into your workspace and connect you with your firm.")
            </p>

            <div class="hero-feature-grid">
                <div class="hero-feature-item">
                    <i class="bi bi-shield-lock"></i>
                    <h4>Secure by Design</h4>
                    <p>Your details stay private and role-protected</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-person-badge"></i>
                    <h4>Verified Identity</h4>
                    <p>CNIC & contact details confirm who you are</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-speedometer2"></i>
                    <h4>Instant Access</h4>
                    <p>Your dashboard unlocks the moment you're done</p>
                </div>
                <div class="hero-feature-item">
                    <i class="bi bi-life-preserver"></i>
                    <h4>Need Help?</h4>
                    <p>Use Logout above if you'd rather finish later</p>
                </div>
            </div>
        </div>

        <div class="auth-hero-right">
            <div class="auth-form-card">
                @if (!_checked)
                {
                    <div class="text-center py-4">
                        <span class="spinner-border spinner-border-sm me-2"></span> Loading your profile…
                    </div>
                }
                else
                {
                    <h2><i class="bi bi-person-check me-2"></i>Complete Your Profile</h2>
                    <p class="auth-subtitle">
                        @(IsFirmAdmin ? "Firm Admin setup" : "Just a couple of quick details")
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger py-2" style="white-space: pre-line;">@_errorMessage</div>
                    }

                    @if (IsFirmAdmin)
                    {
                        <EditForm Model="_adminModel" OnValidSubmit="HandleCompleteFirmAdminAsync">
                            <DataAnnotationsValidator />

                            <div class="auth-section-title">Your Details</div>

                            <div class="mb-3">
                                <label class="form-label">Your Full Name</label>
                                <input class="form-control" @bind="_adminModel.FullName" @bind:event="oninput" disabled="@_isBusy" required />
                                <ValidationMessage For="() => _adminModel.FullName" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Contact Number</label>
                                <input class="form-control" placeholder="03XXXXXXXXX or +923XXXXXXXXX" inputmode="tel"
                                       @bind:get="_adminModel.Phone" @bind:set="v => _adminModel.Phone = InputSanitizers.SanitizePhone(v)" @bind:event="oninput"
                                       disabled="@_isBusy" required />
                                <ValidationMessage For="() => _adminModel.Phone" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">CNIC</label>
                                <input class="form-control" placeholder="35202-1234567-1" inputmode="numeric"
                                       @bind:get="_adminModel.CNIC" @bind:set="v => _adminModel.CNIC = InputSanitizers.SanitizeCnic(v)" @bind:event="oninput"
                                       disabled="@_isBusy" required />
                                <ValidationMessage For="() => _adminModel.CNIC" class="text-danger small" />
                            </div>

                            <div class="auth-section-title">Firm Details</div>

                            <div class="mb-3">
                                <label class="form-label">Firm Name</label>
                                <input class="form-control" @bind="_adminModel.FirmName" @bind:event="oninput" disabled="@_isBusy" required />
                                <ValidationMessage For="() => _adminModel.FirmName" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Firm Address <span class="text-muted fw-normal">(optional)</span></label>
                                <input class="form-control" @bind="_adminModel.Address" @bind:event="oninput" disabled="@_isBusy" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Firm Contact Email <span class="text-muted fw-normal">(optional)</span></label>
                                <input class="form-control" @bind="_adminModel.ContactEmail" @bind:event="oninput" disabled="@_isBusy" />
                                <ValidationMessage For="() => _adminModel.ContactEmail" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Firm Contact Phone <span class="text-muted fw-normal">(optional)</span></label>
                                <input class="form-control" placeholder="03XXXXXXXXX or +923XXXXXXXXX" inputmode="tel"
                                       @bind:get="_adminModel.ContactPhone" @bind:set="v => _adminModel.ContactPhone = InputSanitizers.SanitizePhone(v)" @bind:event="oninput"
                                       disabled="@_isBusy" />
                                <ValidationMessage For="() => _adminModel.ContactPhone" class="text-danger small" />
                            </div>

                            <button type="submit" class="btn btn-auth-primary" disabled="@_isBusy">
                                @if (_isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                Complete Profile
                            </button>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="_userModel" OnValidSubmit="HandleCompleteFirmUserAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Full Name</label>
                                <input class="form-control" @bind="_userModel.FullName" @bind:event="oninput" disabled="@_isBusy" required />
                                <ValidationMessage For="() => _userModel.FullName" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Contact Number</label>
                                <input class="form-control" placeholder="03XXXXXXXXX or +923XXXXXXXXX" inputmode="tel"
                                       @bind:get="_userModel.Phone" @bind:set="v => _userModel.Phone = InputSanitizers.SanitizePhone(v)" @bind:event="oninput"
                                       disabled="@_isBusy" required />
                                <ValidationMessage For="() => _userModel.Phone" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">CNIC</label>
                                <input class="form-control" placeholder="35202-1234567-1" inputmode="numeric"
                                       @bind:get="_userModel.CNIC" @bind:set="v => _userModel.CNIC = InputSanitizers.SanitizeCnic(v)" @bind:event="oninput"
                                       disabled="@_isBusy" required />
                                <ValidationMessage For="() => _userModel.CNIC" class="text-danger small" />
                            </div>

                            <button type="submit" class="btn btn-auth-primary" disabled="@_isBusy">
                                @if (_isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                Complete Profile
                            </button>
                        </EditForm>
                    }
                }
            </div>
        </div>
    </div>

    <PublicFooter />
</div>

@code {
    private bool _checked;
    private bool _isBusy;
    private bool _isDarkTheme;
    private string? _errorMessage;

    private readonly CompleteFirmAdminProfileRequest _adminModel = new();
    private readonly CompleteFirmUserProfileRequest _userModel = new();

    // FirmAdmin is the only role that completes the "firm admin" variant
    // of the form (with Firm details); every other role gets the simpler
    // form.
    private bool IsFirmAdmin => Session.Role == "FirmAdmin";

    protected override async Task OnInitializedAsync()
    {
        await ProfileState.EnsureLoadedAsync();

        // FIX: this used to pre-fill FullName from the backend's
        // placeholder value (the email's local part, e.g.
        // "muhammadsaad3877" for muhammadsaad3877@gmail.com). Since it
        // already looked like a plausible name, people were submitting it
        // unedited - their profile ended up genuinely complete, but their
        // display name across the whole app stayed as their email prefix,
        // which looked like a bypassed/incomplete profile even though it
        // wasn't. Leaving it blank forces a deliberate, real name.

        _checked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("ltsTheme.get");
                _isDarkTheme = theme == "dark";
                StateHasChanged();
            }
            catch
            {
                // JS interop not ready yet (prerender) - default to light theme.
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkTheme = !_isDarkTheme;
        await JS.InvokeVoidAsync("ltsTheme.set", _isDarkTheme ? "dark" : "light");
    }

    private async Task HandleCompleteFirmAdminAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            await ProfileService.CompleteFirmAdminProfileAsync(_adminModel);
            ProfileState.MarkCompleted();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Could not save your profile. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleCompleteFirmUserAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            await ProfileService.CompleteFirmUserProfileAsync(_userModel);
            ProfileState.MarkCompleted();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Could not save your profile. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleLogoutAsync()
    {
        _isBusy = true;
        try
        {
            await AuthService.LogoutAsync();

            var provider = (CustomAuthStateProvider)AuthStateProvider;
            await provider.MarkUserAsLoggedOutAsync();
            ProfileState.Reset();

            Navigation.NavigateTo("/login", forceLoad: true);
        }
        finally
        {
            _isBusy = false;
        }
    }
}
