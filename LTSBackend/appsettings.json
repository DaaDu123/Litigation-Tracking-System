{
  "JwtSettings": {
    "Issuer": "LTSAPI",
    "Audience": "LTSClient",
    "ExpiryMinutes": 7,
    "RefreshTokenDays": 7,
    "UseSecureCookies": true
  },
  "AllowedOrigins": [],
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "LTS System"
  },
  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 10
  },
  "VirusScan": {
    "Enabled": true,
    "FailClosed": true,
    "ClamAvHost": "localhost",
    "ClamAvPort": 3310,
    "TimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
